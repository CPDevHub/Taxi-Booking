{
  "openapi": "3.0.1",
  "info": {
    "title": "Taxi Booking",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/auth/passenger-login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/auth/passenger-signup": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerRegisterDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerRegisterDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PassengerRegisterDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/auth/driver-login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/auth/driver-signup": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DriverRegisterDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/DriverRegisterDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/DriverRegisterDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/auth/is-authenticated": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/driver/api/v1/driver/history": {
      "get": {
        "tags": [
          "Driver"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/driver/api/v1/driver/dashboard": {
      "get": {
        "tags": [
          "Driver"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/driver/api/v1/driver/settings": {
      "get": {
        "tags": [
          "Driver"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/driver/api/v1/driver/rating/{driverId}": {
      "post": {
        "tags": [
          "Driver"
        ],
        "parameters": [
          {
            "name": "driverId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "integer",
                "format": "int32"
              }
            },
            "text/json": {
              "schema": {
                "type": "integer",
                "format": "int32"
              }
            },
            "application/*+json": {
              "schema": {
                "type": "integer",
                "format": "int32"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/passenger/history": {
      "get": {
        "tags": [
          "Passenger"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/ride/book": {
      "post": {
        "tags": [
          "Ride"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRideRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRideRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRideRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateRideRequestDto": {
        "type": "object",
        "properties": {
          "pickupLocation": {
            "$ref": "#/components/schemas/Location"
          },
          "dropOffLocation": {
            "$ref": "#/components/schemas/Location"
          },
          "passengerId": {
            "type": "integer",
            "format": "int32"
          },
          "rideVehicle": {
            "$ref": "#/components/schemas/VehicleType"
          }
        },
        "additionalProperties": false
      },
      "DriverRegisterDto": {
        "required": [
          "avatarUrl",
          "contactNumber",
          "driverVehicleType",
          "email",
          "name",
          "password",
          "vehicleModel",
          "vehicleNumber"
        ],
        "type": "object",
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          },
          "contactNumber": {
            "minLength": 1,
            "type": "string",
            "format": "tel"
          },
          "avatarUrl": {
            "minLength": 1,
            "type": "string"
          },
          "driverVehicleType": {
            "$ref": "#/components/schemas/VehicleType"
          },
          "vehicleNumber": {
            "minLength": 1,
            "type": "string"
          },
          "vehicleModel": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Location": {
        "required": [
          "address",
          "latitude",
          "longitude"
        ],
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "address": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PassengerRegisterDto": {
        "required": [
          "contactNumber",
          "email",
          "name",
          "password"
        ],
        "type": "object",
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          },
          "contactNumber": {
            "minLength": 1,
            "type": "string",
            "format": "tel"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "VehicleType": {
        "enum": [
          "Hatchback",
          "SUV",
          "Sedan"
        ],
        "type": "string"
      }
    }
  }
}